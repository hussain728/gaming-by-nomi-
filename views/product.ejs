<%- include('partials/head') %>

<section class="pdp">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <a href="/shop">Shop</a><span>/</span>
      <% if (category) { %><a href="/shop?category=<%= category.slug %>"><%= category.name %></a><span>/</span><% } %>
      <span aria-current="page"><%= product.name %></span>
    </nav>

    <div class="pdp__grid">
      <% var pics = [product.image].concat(product.gallery || []); %>
      <div class="pdp__gallery reveal">
        <div class="pdp__media">
          <% if (discount(product)) { %><span class="badge badge--sale">Save <%= discount(product) %>%</span><% } else if (product.isNew) { %><span class="badge">New</span><% } %>
          <img src="<%= product.image %>" alt="<%= product.name %>" data-gallery-main>
        </div>
        <% if (pics.length > 1) { %>
          <div class="pdp__thumbs">
            <% pics.forEach(function (src, i) { %>
              <button type="button" class="<%= i === 0 ? 'is-active' : '' %>" data-gallery-thumb="<%= src %>" aria-label="Show picture <%= i + 1 %>"><img src="<%= src %>" alt="" loading="lazy"></button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="pdp__info">
        <p class="eyebrow reveal"><%= product.brand %></p>
        <h1 class="reveal"><%= product.name %></h1>
        <p class="pdp__short reveal"><%= product.short %></p>

        <div class="price price--lg reveal">
          <span class="price__now"><%= money(product.price) %></span>
          <% if (discount(product)) { %><s class="price__was"><%= money(product.comparePrice) %></s><% } %>
        </div>

        <% var canBuy = available(product); var maxQty = tracksStock(product) ? Math.min(20, product.stock) : 20; %>
        <p class="stock reveal <%= canBuy ? 'stock--in' : 'stock--out' %>">
          <span></span><%= !canBuy ? 'Sold out' : tracksStock(product) && product.stock <= 5 ? 'Only ' + product.stock + ' left — ships within 24 hours' : 'In stock — ships within 24 hours' %>
        </p>

        <% if (canBuy) { %>
          <div class="pdp__buy reveal">
            <div class="qty" data-qty>
              <button type="button" data-qty-minus aria-label="Decrease quantity"><svg class="i i-sm"><use href="#i-minus"/></svg></button>
              <input type="number" value="1" min="1" max="<%= maxQty %>" aria-label="Quantity" data-qty-input>
              <button type="button" data-qty-plus aria-label="Increase quantity"><svg class="i i-sm"><use href="#i-plus"/></svg></button>
            </div>
            <button type="button" class="btn btn--primary btn--lg btn--grow" data-add-to-cart="<%= product.id %>" data-name="<%= product.name %>" data-with-qty>Add to Bag</button>
          </div>
          <button type="button" class="btn btn--outline btn--lg btn--block reveal" data-buy-now="<%= product.id %>">Buy it now</button>
        <% } %>
        <a class="btn btn--wa btn--lg btn--block reveal" target="_blank" rel="noopener"
           href="<%= waLink('Hi! I want to order: ' + product.name + ' (' + money(product.price) + ')\n' + config.domain + '/product/' + product.slug) %>">
          <svg class="i"><use href="#i-whatsapp"/></svg> Order on WhatsApp
        </a>

        <ul class="pdp__perks reveal">
          <li><svg class="i"><use href="#i-truck"/></svg><span><b>Delivery all over Pakistan</b>Free over <%= money(config.freeShippingOver) %></span></li>
          <li><svg class="i"><use href="#i-cash"/></svg><span><b>Cash on delivery</b>Pay when it arrives</span></li>
          <li><svg class="i"><use href="#i-shield"/></svg><span><b>7-day checking warranty</b>Easy replacement</span></li>
        </ul>
      </div>
    </div>

    <div class="pdp__details">
      <div class="reveal">
        <h2>Overview</h2>
        <p><%= product.description %></p>
      </div>
      <% if (product.specs && Object.keys(product.specs).length) { %>
        <div class="reveal">
          <h2>Specifications</h2>
          <dl class="specs">
            <% Object.keys(product.specs).forEach(function (k) { %>
              <div><dt><%= k %></dt><dd><%= product.specs[k] %></dd></div>
            <% }) %>
          </dl>
        </div>
      <% } %>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="section section--tint">
  <div class="container">
    <div class="section__head reveal"><h2>You may also like.</h2></div>
    <div class="grid">
      <% related.forEach(function (p) { %><%- include('partials/product-card', { p: p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
