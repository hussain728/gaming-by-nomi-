<%- include('partials/head') %>

<section class="page-head page-head--center">
  <div class="container narrow">
    <p class="eyebrow reveal">About us</p>
    <h1 class="reveal">Gear for people<br>who <span class="grad">play to win.</span></h1>
    <p class="page-head__lead reveal"><%= config.storeName %> started with a simple idea: gamers and music lovers in Pakistan deserve genuine gear, honest prices and support from real people.</p>
  </div>
</section>

<section class="section section--flush">
  <div class="container stats">
    <div class="stat reveal"><b>12+</b><span>Product categories</span></div>
    <div class="stat reveal"><b>24h</b><span>Dispatch time</span></div>
    <div class="stat reveal"><b>100%</b><span>Genuine products</span></div>
    <div class="stat reveal"><b>COD</b><span>All over Pakistan</span></div>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="reveal">
      <h2>What we sell.</h2>
      <p>From gaming headsets, mice, keyboards and controllers to everyday wireless earbuds, handsfree, smart watches, speakers, power banks and chargers — every product we list is one we would use ourselves.</p>
    </div>
    <div class="reveal">
      <h2>How we work.</h2>
      <p>Place an order online or on WhatsApp, and we confirm it with you before dispatch. Pay cash when it arrives. If anything is wrong, message us within 7 days and we will replace it.</p>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-band__inner reveal">
    <div>
      <h2>Talk to us.</h2>
      <p><%= config.phoneDisplay %> · <%= config.email %></p>
    </div>
    <a href="/contact" class="btn btn--light btn--lg">Contact us</a>
  </div>
</section>

<%- include('partials/footer') %>
